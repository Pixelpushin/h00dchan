# This app is deployed as its own Vercel project (root directory =
# breeding-app/), so it owns its own .gitignore rather than relying on the
# parent repo's rooted patterns (e.g. `/node_modules`), which only match the
# repo root and would not cover node_modules created inside this directory.

# dependencies
node_modules

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
